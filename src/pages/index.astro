---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Projects from '../components/Projects.astro';
import Timeline from '../components/Timeline.astro';
import Skills from '../components/Skills.astro';
import { profile } from '../data/profile';
import { experience, education } from '../data/experience';

const year = new Date().getFullYear();
---

<Layout title={`${profile.name} · ${profile.role}`} description={profile.tagline}>
  <Header />
  <main class="mx-auto max-w-5xl px-6">
    <Hero />

    <Section id="projects" title="Projects">
      <Projects />
    </Section>

    <Section id="experience" title="Experience">
      <div class="space-y-12">
        <Timeline heading="Work" entries={experience} />
        <Timeline heading="Education" entries={education} />
      </div>
    </Section>

    <Section id="skills" title="Skills">
      <Skills />
    </Section>
  </main>

  <footer class="border-t border-zinc-200 py-8 text-center text-sm text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
    © {year} {profile.name}
  </footer>
</Layout>
