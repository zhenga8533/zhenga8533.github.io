---
import { profile } from '../data/profile';

const navItems = [
  { label: 'Projects', href: '#projects' },
  { label: 'Experience', href: '#experience' },
  { label: 'Skills', href: '#skills' },
];
---

<header
  class="sticky top-0 z-10 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80"
>
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-6">
    <a href="#top" class="shrink-0 font-semibold whitespace-nowrap text-zinc-900 dark:text-zinc-100">{profile.name}</a>
    <ul class="hidden gap-5 text-sm min-[360px]:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
