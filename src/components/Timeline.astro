---
import type { ExperienceEntry } from '../data/experience';

interface Props {
  heading: string;
  entries: ExperienceEntry[];
}

const { heading, entries } = Astro.props;
---

<div>
  <h3 class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{heading}</h3>
  <ol class="mt-4 space-y-6 border-l border-zinc-200 dark:border-zinc-800">
    {
      entries.map((entry) => (
        <li class="relative pl-6">
          <span class="absolute top-2 -left-1 size-2 rounded-full bg-emerald-500" />
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <p class="font-semibold text-zinc-900 dark:text-zinc-100">
              {entry.title} <span class="font-normal text-zinc-500 dark:text-zinc-400">· {entry.organization}</span>
            </p>
            <p class="text-sm text-zinc-500 tabular-nums dark:text-zinc-400">{entry.period}</p>
          </div>
          <p class="mt-1.5 text-sm leading-relaxed">{entry.description}</p>
        </li>
      ))
    }
  </ol>
</div>
