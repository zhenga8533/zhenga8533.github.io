---
import Icon from './Icon.astro';
import { skillGroups } from '../data/skills';
---

<div class="grid gap-8 sm:grid-cols-3">
  {
    skillGroups.map((group) => (
      <div>
        <h3 class="text-sm font-medium text-zinc-500 dark:text-zinc-400">{group.label}</h3>
        <ul class="mt-4 space-y-3">
          {group.skills.map((skill) => (
            <li class="flex items-center gap-3 text-sm">
              {'icon' in skill ? (
                <img src={skill.icon} alt="" class="size-6 object-contain" loading="lazy" />
              ) : (
                <Icon name={skill.glyph} class="size-6 text-emerald-600 dark:text-emerald-400" />
              )}
              {skill.name}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
