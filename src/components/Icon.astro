---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
const icon = icons[name];
const paint =
  icon.style === 'fill'
    ? { fill: 'currentColor' }
    : ({ fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const);
---

<svg viewBox={icon.viewBox} class={className} aria-hidden="true" {...paint}>
  {icon.paths.map((d) => <path d={d} />)}
</svg>
